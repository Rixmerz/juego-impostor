{
  "name": "juego-impostor",
  "version": "1.0.0",
  "description": "El juego del impostor con UI móvil, para jugar en la misma WiFi",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "lan": "node server/index.js",
    "test": "node test/game.test.js",
    "test:e2e": "node test/e2e.js",
    "test:all": "npm test && npm run test:e2e && npm run test:sesiones",
    "test:sesiones": "node test/e2e-sesiones.js",
    "test:prod": "node test/e2e-produccion.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "impostor",
    "party-game",
    "socket.io",
    "mobile"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
